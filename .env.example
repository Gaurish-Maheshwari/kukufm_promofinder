# ---------------------------------------------------------------------------
# Copy to .env and fill in. ONE key is all you need — the provider is detected
# from its prefix (AQ.…/AIza… Gemini, gsk_… Groq, sk-ant-… Anthropic, sk-or-… OpenRouter,
# sk-… OpenAI, xai-… Grok, nvapi-… NVIDIA, hf_… Hugging Face, csk-… Cerebras).
# Leave it empty to run on rules only (works fully offline).
# ---------------------------------------------------------------------------
LLM_API_KEY=            # paste ONE key here (in .env, never in this file)
# Fallbacks: if the first key fails (invalid, quota, outage) the next one takes over automatically.
# Either list several keys in LLM_API_KEY separated by commas, or put backups here:
# LLM_FALLBACK_API_KEYS=gsk_...,sk-or-...

# Optional overrides — only if you need them
# LLM_PROVIDER=mistral            # force a provider when the key has no prefix (mistral, together, ollama, custom…)
# LLM_MODEL=gemini-2.5-flash      # force a model; otherwise the best cheap model is discovered from /models
# LLM_BASE_URL=http://localhost:11434/v1   # any OpenAI-compatible endpoint (Ollama, vLLM, LM Studio, a gateway)

# Web app
# ALLOW_LOCAL_PATHS=1             # let the UI read server folders under INPUT_ROOT (default on locally, off on Vercel)
# INPUT_ROOT=./data
# MAX_UPLOAD_MB=200
# CORS_ORIGINS=*
